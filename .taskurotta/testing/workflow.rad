radish: 1

workflow:
  name: "testing"

node create-demo-files:
  type: bash-command
  command: |
    mkdir -p .taskurotta/testing/bash-demo
    printf 'alpha\nneedle one\nomega\n' > .taskurotta/testing/bash-demo/first.txt
    printf 'needle two\nbeta\n' > .taskurotta/testing/bash-demo/second.txt
  to: grep-demo-files

node grep-demo-files:
  type: bash-command
  command: grep -nH 'needle' .taskurotta/testing/bash-demo/*.txt
  needs: create-demo-files
  to: delete-demo-files

node delete-demo-files:
  type: bash-command
  command: |
    rm -f .taskurotta/testing/bash-demo/first.txt .taskurotta/testing/bash-demo/second.txt
    rmdir .taskurotta/testing/bash-demo
  needs: grep-demo-files
